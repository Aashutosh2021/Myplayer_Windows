<?xml version="1.0" encoding="utf-8"?>
<Wix 
  
  
  xmlns="http://schemas.microsoft.com/wix/2006/wi"
     
  
  
  xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?ifdef JpIsSystemWide ?>
  <?define JpInstallScope="perMachine"?>
  <?else?>
  <?define JpInstallScope="perUser"?>
  <?endif?>
  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>
  <?include $(var.JpConfigDir)/overrides.wxi ?>
  <!--
    Id="*" generates a fresh ProductCode GUID on every build.
    Combined with IncludeMaximum="yes" on UpgradeVersion and our custom MyPlayerMaintenanceDlg,
    whenever MyPlayer is already installed (same version or older version), the installer
    automatically presents:
      (1) Update MyPlayer
      (2) Repair MyPlayer
      (3) Uninstall MyPlayer
    plus the [x] Create Desktop Icon checkbox!
  -->
  <Product
    Id="*"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">
    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)"
      InstallPrivileges="elevated"
      Platform="x64"
    />
    <!-- Fast MSZIP cabinet compression so packaging & extraction run 3-5x faster -->
    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" CompressionLevel="mszip" />
    <!--
      MSIFASTINSTALL="7" skips Windows System Restore point creation and redundant costing,
      cutting installer execution time from ~30s down to ~3s.
      REINSTALLMODE="omus" only overwrites older/missing files instead of slow unconditional 'amus'.
    -->
    <Property Id="MSIFASTINSTALL" Value="7" />
    <Property Id="DISABLEROLLBACK" Value="1" />
    <Property Id="REINSTALLMODE" Value="omus" />
    <!-- Upgrade & Maintenance state properties preserved across UAC elevation -->
    <Property Id="JP_UPGRADABLE_FOUND" Secure="yes" />
    <Property Id="JP_DOWNGRADABLE_FOUND" Secure="yes" />
    <Property Id="CREATE_DESKTOP_ICON" Value="1" Secure="yes" />
    <Property Id="MAINT_DESKTOP_ICON" Value="1" Secure="yes" />
    <Property Id="MYPLAYER_MAINT_MODE" Value="Update" Secure="yes" />
    <Property Id="ErrorDialog" Value="MyPlayerErrorDlg" />
    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <!-- Matches any installed version <= current version -->
      <UpgradeVersion
        OnlyDetect="no"
        Property="JP_UPGRADABLE_FOUND"
        Minimum="0.0.0.0"
        IncludeMinimum="yes"
        Maximum="$(var.JpAppVersion)"
        IncludeMaximum="yes"
        MigrateFeatures="yes" />
      <!-- Matches any newer version for downgrade handling -->
      <UpgradeVersion
        OnlyDetect="no"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        IncludeMinimum="no"
        MigrateFeatures="yes" />
    </Upgrade>
    <Binary Id="JpCaDll" SourceFile="wixhelper.dll"/>
    <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />
    <!-- Fast termination of any running MyPlayer.exe instance before file operations -->
    <CustomAction
      Id="JpCloseRunningApp"
      Directory="TARGETDIR"
      ExeCommand="cmd.exe /c &quot;taskkill /F /IM MyPlayer.exe /T &gt;nul 2&gt;&amp;1 &amp; exit /b 0&quot;"
      Execute="immediate"
      Return="ignore" />
    <!-- If user selected 'Uninstall' on a newly built installer where JP_UPGRADABLE_FOUND is set -->
    <CustomAction
      Id="JpUninstallExistingViaMsiExec"
      Directory="TARGETDIR"
      ExeCommand="msiexec.exe /x [JP_UPGRADABLE_FOUND] /qb!"
      Execute="immediate"
      Return="ignore" />
    <!-- Creates Desktop Shortcut (MyPlayer.lnk) when 'Create Desktop Icon' is checked -->
    <CustomAction
      Id="JpCreateDesktopShortcut"
      Directory="TARGETDIR"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;$ws = New-Object -ComObject WScript.Shell; $lnk = $ws.CreateShortcut([Environment]::GetFolderPath('Desktop') + '\MyPlayer.lnk'); $lnk.TargetPath = '[INSTALLDIR]MyPlayer.exe'; $lnk.WorkingDirectory = '[INSTALLDIR]'; $lnk.IconLocation = '[INSTALLDIR]MyPlayer.exe,0'; $lnk.Save()&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <!-- Removes Desktop Shortcut when 'Create Desktop Icon' is unchecked or during Uninstall -->
    <CustomAction
      Id="JpRemoveDesktopShortcut"
      Directory="TARGETDIR"
      ExeCommand="cmd.exe /c &quot;del /F /Q &quot;%USERPROFILE%\Desktop\MyPlayer.lnk&quot; &gt;nul 2&gt;&amp;1 &amp; del /F /Q &quot;%PUBLIC%\Desktop\MyPlayer.lnk&quot; &gt;nul 2&gt;&amp;1 &amp; exit /b 0&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <!-- Standard required root -->
    <Directory Id="TARGETDIR" Name="SourceDir"/>
    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
    </Feature>
    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />
    <?ifdef JpHelpURL ?>
    <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>
    <?ifdef JpAboutURL ?>
    <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>
    <?ifdef JpUpdateURL ?>
    <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>
    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>
    <!-- ═══════════════════════════════════════════════════════════════════════════
         CUSTOM MYPLAYER INSTALLER & MAINTENANCE UI (Update / Repair / Uninstall + Desktop Icon)
         Replaces jpackage's barebones JpUI popup with a full interactive wizard!
         ═══════════════════════════════════════════════════════════════════════════ -->
    <UI Id="MyPlayerSetupUI">
      <UIRef Id="WixUI_Common" />
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" Bold="yes" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="10" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="MyPlayerErrorDlg" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MyPlayerCancelDlg" />
      <DialogRef Id="MyPlayerProgressDlg" />
      <DialogRef Id="MyPlayerExitDlg" />
      <!-- 1. FRESH INSTALL DIALOG (Shown when MyPlayer is not installed yet) -->
      <Dialog Id="MyPlayerInstallDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup">
        <Control Id="BannerTitle" Type="Text" X="20" Y="18" Width="330" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}Welcome to $(var.JpAppName) $(var.JpAppVersion) Setup" />
        <Control Id="BannerSub" Type="Text" X="20" Y="46" Width="330" Height="32" Transparent="yes" NoPrefix="yes"
                 Text="High-Resolution Desktop Audiophile Music Player with 10-Band Rainbow EQ, Real-Time Audio FX Lab, Sync Play, and 6 Customizable Player Styles." />
        <Control Id="TopLine" Type="Line" X="0" Y="84" Width="370" Height="0" />
        <Control Id="InstallInfoText" Type="Text" X="24" Y="102" Width="320" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Click Install Now to install $(var.JpAppName) on your computer. Select your shortcut preference below:" />
        <Control Id="DesktopIconCheck" Type="CheckBox" X="28" Y="142" Width="310" Height="18"
                 Property="CREATE_DESKTOP_ICON" CheckBoxValue="1"
                 Text="Create Desktop Icon (Shortcut on Desktop)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="InstallBtn" Type="PushButton" X="212" Y="236" Width="72" Height="20" Default="yes" Text="&amp;Install Now">
          <Publish Property="JP_INSTALL_DESKTOP_SHORTCUT" Value="1">CREATE_DESKTOP_ICON = "1"</Publish>
          <Publish Property="JP_INSTALL_DESKTOP_SHORTCUT">NOT CREATE_DESKTOP_ICON</Publish>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="CancelBtn" Type="PushButton" X="290" Y="236" Width="64" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="MyPlayerCancelDlg">1</Publish>
        </Control>
      </Dialog>
      <!-- 2. EXISTING INSTALLATION DIALOG: UPDATE / REPAIR / UNINSTALL + CREATE DESKTOP ICON -->
      <Dialog Id="MyPlayerMaintenanceDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup">
        <Control Id="MaintTitle" Type="Text" X="20" Y="16" Width="330" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}$(var.JpAppName) Installation Options" />
        <Control Id="MaintSub" Type="Text" X="20" Y="40" Width="330" Height="22" Transparent="yes" NoPrefix="yes"
                 Text="$(var.JpAppName) is already installed on your PC. Choose an action below:" />
        <Control Id="MaintTopLine" Type="Line" X="0" Y="66" Width="370" Height="0" />
        <Control Id="ActionRadioGroup" Type="RadioButtonGroup" X="24" Y="78" Width="322" Height="96" Property="MYPLAYER_MAINT_MODE">
          <RadioButtonGroup Property="MYPLAYER_MAINT_MODE">
            <RadioButton Value="Update" X="0" Y="0" Width="320" Height="28"
                         Text="{\WixUI_Font_Title}Update $(var.JpAppName) (Recommended)" />
            <RadioButton Value="Repair" X="0" Y="32" Width="320" Height="28"
                         Text="{\WixUI_Font_Title}Repair $(var.JpAppName) (Fix missing or corrupted files)" />
            <RadioButton Value="Uninstall" X="0" Y="64" Width="320" Height="28"
                         Text="{\WixUI_Font_Title}Uninstall $(var.JpAppName) (Remove from computer)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="MaintDesktopIconCheck" Type="CheckBox" X="28" Y="188" Width="310" Height="18"
                 Property="MAINT_DESKTOP_ICON" CheckBoxValue="1"
                 Text="Create Desktop Icon (Shortcut on Desktop)">
          <Condition Action="disable">MYPLAYER_MAINT_MODE = "Uninstall"</Condition>
          <Condition Action="enable">MYPLAYER_MAINT_MODE &lt;&gt; "Uninstall"</Condition>
        </Control>
        <Control Id="MaintBottomLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="ContinueBtn" Type="PushButton" X="212" Y="236" Width="72" Height="20" Default="yes" Text="&amp;Continue">
          <!-- Sync desktop shortcut properties -->
          <Publish Property="CREATE_DESKTOP_ICON" Value="1">MAINT_DESKTOP_ICON = "1" AND MYPLAYER_MAINT_MODE &lt;&gt; "Uninstall"</Publish>
          <Publish Property="CREATE_DESKTOP_ICON">NOT MAINT_DESKTOP_ICON OR MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <Publish Property="JP_INSTALL_DESKTOP_SHORTCUT" Value="1">MAINT_DESKTOP_ICON = "1" AND MYPLAYER_MAINT_MODE &lt;&gt; "Uninstall"</Publish>
          <Publish Property="JP_INSTALL_DESKTOP_SHORTCUT">NOT MAINT_DESKTOP_ICON OR MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <!-- Mode 1: UPDATE -->
          <Publish Property="REINSTALLMODE" Value="omus">MYPLAYER_MAINT_MODE = "Update"</Publish>
          <Publish Property="REINSTALL" Value="ALL">Installed AND MYPLAYER_MAINT_MODE = "Update"</Publish>
          <!-- Mode 2: REPAIR -->
          <Publish Property="REINSTALLMODE" Value="ecmus">MYPLAYER_MAINT_MODE = "Repair"</Publish>
          <Publish Property="REINSTALL" Value="ALL">Installed AND MYPLAYER_MAINT_MODE = "Repair"</Publish>
          <!-- Mode 3: UNINSTALL (Same MSI ProductCode) -->
          <Publish Property="REMOVE" Value="ALL">Installed AND MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <!-- Mode 3b: UNINSTALL (New MSI build over existing install via JP_UPGRADABLE_FOUND) -->
          <Publish Event="DoAction" Value="JpCloseRunningApp">NOT Installed AND JP_UPGRADABLE_FOUND AND MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <Publish Event="DoAction" Value="JpUninstallExistingViaMsiExec">NOT Installed AND JP_UPGRADABLE_FOUND AND MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <Publish Event="EndDialog" Value="Exit">NOT Installed AND JP_UPGRADABLE_FOUND AND MYPLAYER_MAINT_MODE = "Uninstall"</Publish>
          <!-- Proceed to execute install/update/repair/same-MSI-uninstall -->
          <Publish Event="EndDialog" Value="Return">Installed OR MYPLAYER_MAINT_MODE &lt;&gt; "Uninstall"</Publish>
        </Control>
        <Control Id="MaintCancelBtn" Type="PushButton" X="290" Y="236" Width="64" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="MyPlayerCancelDlg">1</Publish>
        </Control>
      </Dialog>
      <!-- 3. PROGRESS DIALOG (Modeless live progress bar during execution) -->
      <Dialog Id="MyPlayerProgressDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup" Modeless="yes">
        <Control Id="ProgTitle" Type="Text" X="20" Y="18" Width="330" Height="24" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}Configuring $(var.JpAppName)..." />
        <Control Id="ProgSub" Type="Text" X="20" Y="44" Width="330" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="Please wait while Setup processes your selected operation." />
        <Control Id="ProgTopLine" Type="Line" X="0" Y="70" Width="370" Height="0" />
        <Control Id="ActionText" Type="Text" X="24" Y="100" Width="320" Height="20" Transparent="yes" NoPrefix="yes" Text="Status: Preparing files...">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="24" Y="128" Width="322" Height="16" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="ProgBottomLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="ProgCancelBtn" Type="PushButton" X="290" Y="236" Width="64" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="MyPlayerCancelDlg">1</Publish>
        </Control>
      </Dialog>
      <!-- 4. COMPLETION / EXIT DIALOG -->
      <Dialog Id="MyPlayerExitDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup">
        <Control Id="ExitTitle" Type="Text" X="20" Y="24" Width="330" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}$(var.JpAppName) Setup Completed" />
        <Control Id="ExitDesc" Type="Text" X="20" Y="64" Width="330" Height="44" Transparent="yes" NoPrefix="yes"
                 Text="Setup has finished processing $(var.JpAppName) on your computer. Click Finish to close Setup." />
        <Control Id="ExitBottomLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="FinishBtn" Type="PushButton" X="282" Y="236" Width="72" Height="20" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
      <!-- 5. CANCEL CONFIRMATION DIALOG -->
      <Dialog Id="MyPlayerCancelDlg" Width="260" Height="95" Title="$(var.JpAppName) Setup">
        <Control Id="CancelText" Type="Text" X="18" Y="18" Width="224" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Are you sure you want to cancel $(var.JpAppName) Setup?" />
        <Control Id="YesBtn" Type="PushButton" X="62" Y="58" Width="60" Height="18" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="NoBtn" Type="PushButton" X="134" Y="58" Width="60" Height="18" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
      <!-- 6. STANDARD MSI ERROR DIALOG -->
      <Dialog Id="MyPlayerErrorDlg" Width="270" Height="105" Title="$(var.JpAppName) Setup Information" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="18" Y="16" Width="234" Height="48" TabSkip="no" Text="Information text" />
        <Control Id="Y" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="ErrorYes">1</Publish>
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="&amp;Abort">
          <Publish Event="EndDialog" Value="ErrorAbort">1</Publish>
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel">1</Publish>
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore">1</Publish>
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="ErrorNo">1</Publish>
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk">1</Publish>
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="72" Width="56" Height="17" TabSkip="yes" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="ErrorRetry">1</Publish>
        </Control>
      </Dialog>
      <!-- 7. USER EXIT DIALOG -->
      <Dialog Id="MyPlayerUserExitDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup">
        <Control Id="UserExitTitle" Type="Text" X="20" Y="24" Width="330" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}$(var.JpAppName) Setup Interrupted" />
        <Control Id="UserExitDesc" Type="Text" X="20" Y="64" Width="330" Height="44" Transparent="yes" NoPrefix="yes"
                 Text="Setup was interrupted before $(var.JpAppName) could be configured. Your system has not been modified." />
        <Control Id="UserExitLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="UserExitFinishBtn" Type="PushButton" X="282" Y="236" Width="72" Height="20" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <!-- 9. FATAL ERROR DIALOG -->
      <Dialog Id="MyPlayerFatalErrorDlg" Width="370" Height="270" Title="$(var.JpAppName) $(var.JpAppVersion) Setup">
        <Control Id="FatalTitle" Type="Text" X="20" Y="24" Width="330" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}$(var.JpAppName) Setup Ended Prematurely" />
        <Control Id="FatalDesc" Type="Text" X="20" Y="64" Width="330" Height="44" Transparent="yes" NoPrefix="yes"
                 Text="$(var.JpAppName) Setup ended prematurely because of an error. Your system has not been modified." />
        <Control Id="FatalLine" Type="Line" X="0" Y="224" Width="370" Height="0" />
        <Control Id="FatalFinishBtn" Type="PushButton" X="282" Y="236" Width="72" Height="20" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
        <!-- Show Fresh Install Dialog when MyPlayer is NOT yet installed -->
        <Show Dialog="MyPlayerInstallDlg" Before="MyPlayerProgressDlg">NOT Installed AND NOT JP_UPGRADABLE_FOUND</Show>
        <!-- Show Update / Repair / Uninstall Maintenance Dialog when MyPlayer IS already installed -->
        <Show Dialog="MyPlayerMaintenanceDlg" Before="MyPlayerProgressDlg">Installed OR JP_UPGRADABLE_FOUND</Show>
        <Show Dialog="MyPlayerProgressDlg" Before="ExecuteAction" />
        <Show Dialog="MyPlayerExitDlg" OnExit="success" />
        <Show Dialog="MyPlayerUserExitDlg" OnExit="cancel" />
        <Show Dialog="MyPlayerFatalErrorDlg" OnExit="error" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="MyPlayerExitDlg" OnExit="success" />
        <Show Dialog="MyPlayerUserExitDlg" OnExit="cancel" />
        <Show Dialog="MyPlayerFatalErrorDlg" OnExit="error" />
      </AdminUISequence>
    </UI>
    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
      <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
      <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
      <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <!-- Always close running MyPlayer.exe before modifying/removing files -->
      <Custom Action="JpCloseRunningApp" After="CostFinalize">1</Custom>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts"/>
      <RemoveExistingProducts After="InstallInitialize"/>
      <!-- Sync Desktop Icon according to checkbox on Install, Update, Repair, and Uninstall -->
      <Custom Action="JpCreateDesktopShortcut" Before="InstallFinalize">CREATE_DESKTOP_ICON = "1" AND MYPLAYER_MAINT_MODE &lt;&gt; "Uninstall" AND REMOVE &lt;&gt; "ALL"</Custom>
      <Custom Action="JpRemoveDesktopShortcut" Before="InstallFinalize">NOT CREATE_DESKTOP_ICON OR MYPLAYER_MAINT_MODE = "Uninstall" OR REMOVE = "ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
